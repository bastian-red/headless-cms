# headless-cms environment.
#
#   cp .env.example .env
#   sed -i "s|^AUTH_SECRET=|AUTH_SECRET=$(openssl rand -base64 32)|" .env
#
# Every name here is declared in turbo.json, and `node scripts/env-contract.mjs`
# fails the commit if this file, the source and turbo.json disagree. Turborepo 2
# runs in strict environment mode, so a name turbo.json forgets is stripped from
# the child process silently. Nothing loads this file on its own: `pnpm dev`
# runs scripts/dev.sh, which sources it.

# --- Core ---

# Leave unset for development: `next build` must not see "development".
NODE_ENV=

APP_VERSION=0.1.0

# --- Database (Postgres) ---

# Compose publishes Postgres on 5444: 5432 is the host's own server and
# 5433-5443 belong to sibling stacks.
DATABASE_URL=postgresql://cms:cms@localhost:5444/cms?schema=public

# --- Redis ---

# The throttler's counters today; the publisher's queue from build step 7.
REDIS_URL=redis://localhost:6390

# --- API service ---

API_PORT=4000

# PORT wins over API_PORT, matching what every container runtime injects. Empty
# locally: the web app reads PORT too.
PORT=

# Where the web app's server code reaches the API. The browser never calls it.
API_BASE_URL=http://localhost:4000

# Requests per minute. Signed-in calls are counted per user, anonymous ones per
# address. The two special budgets must stay below the global one or the API
# refuses to start.
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=5
RATE_LIMIT_COMMENT=10

# --- Publisher service ---

# The publisher's own /health listens here.
PUBLISHER_HEALTH_PORT=4400

# Where the API reaches the publisher for GET /status.
PUBLISHER_INTERNAL_URL=http://localhost:4400

# --- Web app ---

WEB_PORT=3000

# The site's public origin: canonical URLs, the sitemap and the feed are built
# from it, so it must be the address readers use. Baked into prerendered pages.
APP_BASE_URL=http://localhost:3000

# The public site reads published content through the content API with its own
# key, like any headless client. `pnpm db:seed` registers this key's hash.
# Generate one, then `pnpm db:seed`:
#   sed -i "s|^CONTENT_API_KEY=.*|CONTENT_API_KEY=$(node scripts/new-api-key.mjs)|" .env
CONTENT_API_KEY=

# Leave unset. `deferred` builds the site without an API to read (the Docker
# image does): every public page then renders per request, with its content
# reads still cached. Any other build prerenders, and fails without the API.
CONTENT_AT_BUILD=

# --- Auth ---

# One value, two processes: the web app mints a short-lived HS256 service token
# and the API verifies it. At least 16 characters.
AUTH_SECRET=

# Auth.js reads this directly to build callback URLs.
AUTH_URL=http://localhost:3000
