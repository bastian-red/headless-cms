# syntax=docker/dockerfile:1.7
#
# services/publisher, multi-stage. Build from the REPO ROOT:
#   docker build -f infra/Dockerfile.publisher -t cms-publisher .

FROM node:20-bookworm-slim AS base
# openssl: Prisma's query engine links against it, and bookworm-slim ships without.
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS fetch
# patches/ too: the lockfile names a patched dependency, and fetch refuses
# to run without its patch file.
# package.json for its pnpm.supportedArchitectures: glibc binaries only. Without
# it the store also carries the musl builds of next's compiler and sharp
# (about 300 MB) that a bookworm image never loads.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
# --ignore-scripts: simple-git-hooks' postinstall walks up for a package.json this
# stage has deliberately not copied, and crashes the fetch.
RUN pnpm fetch --ignore-scripts

FROM fetch AS build
COPY . .
RUN pnpm install --frozen-lockfile --offline --ignore-scripts
RUN --mount=type=cache,id=cms-deploy-cache,sharing=locked,target=/root/.cache \
  pnpm --filter @cms/db run generate
RUN pnpm exec turbo run build --filter=@cms/publisher...

FROM build AS prod-deps
# A default deploy wrote 3.5x the deployment into its layer: ~195 MB of registry
# metadata and engine downloads into /root/.cache, plus every store file it
# hardlinked, copied up out of the lower layer. A 12 GB Docker disk ran out.
# So /root/.cache is a cache mount (shared by every deploy, in no layer) and
# packages are copied from the store, which leaves the store untouched.
RUN --mount=type=cache,id=cms-deploy-cache,sharing=locked,target=/root/.cache \
  pnpm --filter @cms/publisher deploy --prod --config.package-import-method=copy /prod/publisher
RUN test -f /prod/publisher/dist/main.js || \
  (echo "prod-deps: /prod/publisher/dist/main.js is missing after pnpm deploy." >&2 && exit 1)
RUN test -d /prod/publisher/node_modules/@cms/db/generated/client || \
  (echo "prod-deps: the generated Prisma client did not survive pnpm deploy." >&2 && exit 1)

FROM node:20-bookworm-slim AS runtime
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 1001 app \
  && useradd --uid 1001 --gid app --shell /usr/sbin/nologin --no-create-home app
WORKDIR /app
COPY --from=prod-deps --chown=app:app /prod/publisher ./
USER app
ENV NODE_ENV=production
EXPOSE 4400
# /health checks Postgres and Redis for real, so a green container has both
# behind it.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PUBLISHER_HEALTH_PORT||4400)+'/health',(r)=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/main.js"]
