{
  "$schema": "https://turbo.build/schema.json",

  // Turborepo 2 defaults to envMode: "strict". A task's child process sees only
  // the names listed below plus turbo's own system allowlist; everything else is
  // stripped with no warning. That is left on deliberately -- it is the reason
  // scripts/env-contract.mjs can be a meaningful gate -- but it does mean a name
  // this file forgets is a name the running app never sees.
  //
  // Verify with: turbo run dev --dry=json   (it reports globalEnvMode).

  // globalEnv values are hashed into the cache key, so this list is only for
  // names that change what gets BUILT. A secret must never appear here, because
  // its value would become part of a hash input.
  // APP_BASE_URL is baked into prerendered pages (canonical URLs, the feed,
  // the sitemap) and CONTENT_AT_BUILD decides whether they are prerendered.
  "globalEnv": ["API_BASE_URL", "APP_BASE_URL", "CONTENT_AT_BUILD", "NODE_ENV"],

  // Runtime configuration. Read by the process, never baked into an artefact,
  // so a change here must not invalidate a cached build.
  "globalPassThroughEnv": [
    "API_PORT",
    "APP_VERSION",
    "AUTH_SECRET",
    "AUTH_URL",
    "CONTENT_API_KEY",
    "DATABASE_URL",
    "PORT",
    "PUBLISHER_HEALTH_PORT",
    "PUBLISHER_INTERNAL_URL",
    "RATE_LIMIT_AUTH",
    "RATE_LIMIT_COMMENT",
    "RATE_LIMIT_GLOBAL",
    "REDIS_URL",
    "WEB_PORT"
  ],

  "tasks": {
    // dependsOn ^build because every app imports workspace packages through
    // dist/. On a machine that has built once this looks unnecessary; on a clean
    // checkout it is the difference between a working command and a stack trace
    // about a missing module.
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    // The site's build reads published content from the API and prerenders it,
    // so its output depends on data no input hash can see. A cached replay
    // would serve last week's posts (or a deleted draft) with a green build.
    "@cms/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": false
    },
    // The render check spawns dist/worker.js, so its test needs this package
    // built, not only its dependencies.
    "@cms/markdown#test": {
      "dependsOn": ["^build", "build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "seed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "migrate:deploy": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
